# Runtime user used by web/render-worker and persistent writable storage.
# Change these only when your Docker host requires a specific numeric UID/GID.
NIGHTLIGHT_UID=10001
NIGHTLIGHT_GID=10001

NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_APP_VERSION=development
DATABASE_URL=postgresql://nightlight:nightlight@localhost:5432/nightlight
NUXT_SESSION_PASSWORD=dev-only-change-me-at-least-32-characters
NUXT_SESSION_COOKIE_SECURE=false
OWNER_BOOTSTRAP_TOKEN=dev-bootstrap-change-me
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=DJ NightLight <noreply@example.com>
REVIEW_URL=

# Render worker: bitrate for Intel GPU (VAAPI) exports. On Docker Desktop
# (macOS/Windows) point NIGHTLIGHT_DRI_PATH at an empty folder, since /dev
# cannot be shared there.
RENDER_VIDEO_BITRATE=10M
# NIGHTLIGHT_DRI_PATH=./.no-gpu
