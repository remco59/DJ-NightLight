FROM node:22-bookworm-slim

WORKDIR /app
ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
ENV HOME=/tmp

RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium ffmpeg ca-certificates fonts-liberation \
  && rm -rf /var/lib/apt/lists/*

COPY package.json ./
RUN npm install --no-audit --no-fund

ENV NODE_ENV=production

COPY . .

RUN addgroup --system nightlight \
  && adduser --system --ingroup nightlight nightlight \
  && mkdir -p /app/storage/uploads /app/storage/generated \
  && chown -R nightlight:nightlight /app/storage

USER nightlight
CMD ["npm", "run", "worker:video"]
