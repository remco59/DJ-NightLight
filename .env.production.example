COMPOSE_PROJECT_NAME=djnightlight
APP_DATA_ROOT=/mnt/user/appdata/djnightlight
APP_PORT=3080
POSTGRES_DB=nightlight
POSTGRES_USER=nightlight
POSTGRES_PASSWORD=change-me
NUXT_PUBLIC_SITE_URL=https://djnightlight.nl
NUXT_APP_VERSION=production
NUXT_SESSION_PASSWORD=change-me-at-least-32-characters-long
NUXT_SESSION_COOKIE_SECURE=true
OWNER_BOOTSTRAP_TOKEN=change-me-then-remove-after-first-owner
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
PROXY_NETWORK=proxynet
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=DJ NightLight <noreply@example.com>
REVIEW_URL=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_SECONDARY_ROOT=/mnt/user/backups/djnightlight
