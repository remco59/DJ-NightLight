COMPOSE_PROJECT_NAME=djnightlight
APP_DATA_ROOT=/mnt/user/appdata/djnightlight
APP_PORT=3080
POSTGRES_DB=nightlight
POSTGRES_USER=nightlight
POSTGRES_PASSWORD=change-me
NUXT_PUBLIC_SITE_URL=https://djnightlight.nl
NUXT_APP_VERSION=production
NUXT_SESSION_PASSWORD=change-me-at-least-32-characters-long
NUXT_SESSION_COOKIE_SECURE=true
OWNER_BOOTSTRAP_TOKEN=change-me-then-remove-after-first-owner
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
PROXY_NETWORK=proxynet
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_LOGIN_CONFIG_ID=
RESEND_API_KEY=
EMAIL_FROM=DJ NightLight <noreply@example.com>
REVIEW_URL=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_SECONDARY_ROOT=/mnt/user/backups/djnightlight

# Bitrate for Intel GPU (VAAPI) video exports.
RENDER_VIDEO_BITRATE=10M

# In-app updates (Admin → Settings → Software-updates). Leave UPDATER_TOKEN empty
# to disable. NIGHTLIGHT_REPO_PATH is the absolute path of this server checkout,
# NIGHTLIGHT_ENV_FILE the absolute path of this env file.
UPDATER_TOKEN=
UPDATER_BRANCH=main
# Only needed when the repository is private: a fine-grained GitHub token with
# read-only "Contents" access to this repository.
UPDATER_GIT_TOKEN=
NIGHTLIGHT_REPO_PATH=
NIGHTLIGHT_ENV_FILE=

# Optional: host folder linked read-only into the media library (not copied).
# MEDIA_LIBRARY_PATH="/mnt/user/home/Merken & Projecten/DJ NightLight"
